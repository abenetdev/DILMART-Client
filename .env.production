# Replace this with your actual Render backend URL after deploying
VITE_API_URL=https://dilmart-server.onrender.com

# Google OAuth — must match the client ID in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Firebase Web SDK (FCM push notifications — vendor dashboard) ────────────
# Set these in Vercel environment variables (never commit real values)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key-from-firebase-console
